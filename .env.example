# Copy to .env (same folder) and change only what you need. Every value has a safe default.
# Environment variables set in the shell override this file.
#
# The Settings page (frontend /settings, API /api/settings) stores the house style and some
# pipeline values in MongoDB. Pipeline values from Settings apply on top of this file but can only
# switch providers OFF, raise thresholds (identity, visual verification, minimum resolution) or
# lower limits (upload size, enlargement). API keys, monthly caps, the server address, models and
# VISION_VERIFY_CANDIDATES stay here only and are never sent to the browser.

# --- Server -------------------------------------------------------------------------------
# Loopback only by default: the API has no login. Use 0.0.0.0 only on a network you fully trust.
HOST=127.0.0.1
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/kanyaraasi_memes
# Extra hosts/origins allowed to call the API (comma lists), e.g. a LAN name for the frontend.
# ALLOWED_HOSTS=
# CORS_ORIGINS=
# Viral adaptations allowed to run at the same time (each uses the vision CLI several times).
ADAPTATION_MAX_CONCURRENT=1

# --- Vision engine ----------------------------------------------------------------------------
# Viral adaptation, layout learning and picture checks need a vision model. Two engines, same results:
#   1) the Antigravity CLI ("agy") signed in on THIS computer (used automatically when it is found), or
#   2) the Gemini API: put a key from Google AI Studio in GEMINI_API_KEY. This is what a hosted server
#      (Render, a VPS ...) uses, because it has no CLI. Pictures are sent to Google for analysis.
# Automatic choice: the CLI when it is installed, otherwise the Gemini API when a key is set.
# Force one with VISION_BACKEND=cli or VISION_BACKEND=gemini-api.
# GEMINI_API_KEY=
# VISION_BACKEND=auto
# Gemini model ids and thinking level per task (MINIMAL, LOW, MEDIUM, HIGH, XHIGH, or off for models without thinking levels).
# GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
# GEMINI_VERIFY_MODEL=gemini-3.8-flash
# GEMINI_INSTRUCTION_MODEL=gemini-3.8-flash
# GEMINI_ANALYSIS_THINKING=MEDIUM
# GEMINI_VERIFY_THINKING=LOW
# GEMINI_INSTRUCTION_THINKING=LOW
# A free key has low per-minute limits; viral adaptation makes many calls, so a paid (billing-enabled) key is smoother.

# --- Vision CLI (Antigravity "agy") ---------------------------------------------------------
# Found automatically in %USERPROFILE%\.gemini\bin\agy.exe. Set this only if it lives elsewhere.
# VISION_CLI_PATH=C:\Users\<you>\.gemini\bin\agy.exe
# Models (see `agy models`). VISION_MODEL overrides all three.
VISION_ANALYSIS_MODEL=gemini-3.8-flash-medium
VISION_VERIFY_MODEL=gemini-3.8-flash-low
VISION_INSTRUCTION_MODEL=gemini-3.8-flash-low
VISION_TIMEOUT_MS=180000
VISION_MAX_ATTEMPTS=2
VISION_MAX_CONCURRENT=2
# "required": every subject image must pass visual verification (recommended).
# "off": select by metadata only (weaker; a warning is recorded in the generation report).
VISION_VERIFY_CANDIDATES=required
# Keep per-run sandbox folders for debugging (contains the images sent to the model).
VISION_KEEP_RUN_FILES=false

# --- Identity --------------------------------------------------------------------------------
# Minimum AI confidence to accept an AI identification for an unnamed or ambiguous subject.
IDENTITY_AI_MIN_CONFIDENCE=0.8

# --- Internet image discovery ----------------------------------------------------------------
# Rights policy for subject images:
#   allow_copyrighted (default): film stills, studio promotional images, celebrity, news and
#     editorial photos may be used. Every selected image is labelled "openly licensed" or
#     "copyrighted: reuse permission not confirmed" in the meme and its generation report.
#   open_license_only: only openly licensed images (public domain, CC0, CC BY, CC BY-SA ...).
# Identity, visual verification, relevance and quality checks are the same in both modes.
DISCOVERY_RIGHTS_POLICY=allow_copyrighted
# Default: wikimedia-commons,wikipedia,openverse (free, official), plus every keyed provider below.
# DISCOVERY_PROVIDERS=wikimedia-commons,wikipedia,openverse,google-vision-web,brave-images

# Google Cloud Vision reverse image search (Web Detection) of each subject slot's crop from the
# reference: finds the exact underlying picture and the pages that carry it. Paid per image after
# Google's free tier (first 1000 per month). Only the subject crop is sent, never your reaction
# image or punchline. The cap below stops requests at the free tier; raise it only if you accept
# paid usage. Needs a Google Cloud project with the Vision API enabled (and billing set up).
# GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_VISION_MONTHLY_UNIT_LIMIT=1000

# Brave Image Search API (web image search by text). $5 per 1000 requests with a $5 monthly credit.
# The cap below (about the free credit) stops requests; raise it only if you accept paid usage.
# Brave's terms allow only temporary storage of its results: titles and links of Brave results are
# never stored (the meme records the provider and the rights label instead).
# BRAVE_SEARCH_API_KEY=
BRAVE_MONTHLY_REQUEST_LIMIT=1000
# Country for Brave results (two-letter code, or ALL).
BRAVE_SEARCH_COUNTRY=IN
# Brave requests per subject slot (each costs one request).
DISCOVERY_BRAVE_QUERIES_PER_SLOT=2
# Unofficial DuckDuckGo image search (undocumented endpoint, may break or be blocked). Off by default.
DISCOVERY_ALLOW_UNOFFICIAL=false
# Allow a verified photo of the SAME person when the requested picture type (e.g. a film still)
# cannot be found. Off by default: an event photo is not a film still.
DISCOVERY_ALLOW_TYPE_FALLBACK=false
DISCOVERY_SHORTLIST_SIZE=4
DISCOVERY_MAX_ROUNDS=3
DISCOVERY_SLOT_TIMEOUT_MS=420000
# Wikimedia asks API clients to identify themselves with contact details. Add yours here if you
# want fewer rate limits (HTTP 429), e.g. "MemeAdaptationEngine/2.0 (you@example.com)".
# HTTP_USER_AGENT=

# Optional TMDB provider (actor photos, film backdrops/stills and posters). TMDB's standard API
# terms forbid commercial use, use "in connection with ... an artificial intelligence (AI) based
# Application" and making derivatives, so a key alone does NOT enable it. Set
# TMDB_COMMERCIAL_AGREEMENT=true only if you have a written TMDB agreement that permits this use.
# TMDB_API_KEY=
# TMDB_READ_ACCESS_TOKEN=
TMDB_COMMERCIAL_AGREEMENT=false

# Google Programmable Search: closed to new customers and shut down by Google on 2027-01-01.
# Works only with existing keys until then.
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=

# --- Instagram / Meta Integration -------------------------------------------------------------
# Meta App Name: Mythri Restaurant
META_APP_ID=1157226127472052
# Set your Meta App Secret from Meta Developer Dashboard > App settings > Basic
META_APP_SECRET=
INSTAGRAM_APP_ID=2049776039055092
INSTAGRAM_LOGIN_CONFIG_ID=1684279023426778
INSTAGRAM_REDIRECT_URI=https://jailer-effective-wiring.ngrok-free.dev/api/instagram/auth/callback
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_TARGET_USERNAME=kanyaraasi_memes

# --- WhatsApp bot -----------------------------------------------------------------------------
# Public HTTPS origin Instagram fetches generated images from (WhatsApp pictures are uploaded directly and do not need it).
# On Render it is filled in by itself (RENDER_EXTERNAL_URL). Otherwise set it; with nothing set it defaults to
# INSTAGRAM_REDIRECT_URI minus its path, which is a local tunnel (ngrok) and is wrong for a hosted server.
# PUBLIC_BASE_URL=https://your-service.onrender.com
# Webhook POSTs are rejected unless X-Hub-Signature-256 matches this app secret (falls back to META_APP_SECRET).
# WHATSAPP_APP_SECRET=
# No defaults: leave these empty and the bot refuses every message / verification.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Digits only, country code included (e.g. 919876543210). Only these numbers may use the bot.
# Several numbers: separate them with commas (e.g. 919876543210,918885550123), at most 10. A number saved in
# the app (Settings > WhatsApp) replaces this list. On a Meta TEST number each one must also be in Meta's recipient list.
WHATSAPP_ALLOWED_PHONE=
WHATSAPP_API_VERSION=v21.0

# --- Login (owner account: create it with `npm run auth:create-owner`) ------------------------
# Login is ON by default. Only turn it off for local development; the server refuses to start with
# login off while listening on a non-loopback HOST or with APP_HOSTS set.
# AUTH_ENABLED=true
# Where you open the studio in the browser (OAuth returns here). Default: the local dev frontend.
# APP_PUBLIC_URL=http://localhost:5173
# Hosting only (see DEPLOY.md): the public host name, one proxy in front, https URL.
# APP_HOSTS=studio.example.com
# APP_PUBLIC_URL=https://studio.example.com
# TRUST_PROXY=1
# AUTH_SESSION_IDLE_DAYS=7
# AUTH_SESSION_MAX_DAYS=30
# AUTH_MAX_FAILURES=5
# AUTH_LOCK_MINUTES=15

# Temporary static login: a fixed username/password from settings, no command needed (handy on hosts
# without a shell, e.g. Render). Weak on purpose for testing: replace it before sharing the address.
# AUTH_STATIC_USERNAME=admin
# AUTH_STATIC_PASSWORD=admin
